SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL: postgresql://user:password@localhost:5432/campaign_dashboard

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Meta (Facebook) App
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8000/api/integrations/meta/callback/

# LinkedIn App
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integrations/linkedin/callback/

# Google (Ads + Sheets)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback/
GOOGLE_DEVELOPER_TOKEN=your-google-ads-developer-token

# Celery / Redis (opcional para sync em background)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
